FROM python:3.14-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    POETRY_VIRTUALENVS_CREATE=false \
    POETRY_NO_INTERACTION=1

WORKDIR /app

# Dependências antes do código: o cache desta camada só invalida quando o lock muda.
RUN pip install --no-cache-dir "poetry>=2,<3"
COPY pyproject.toml poetry.lock ./
RUN poetry install --only main --no-root

COPY alembic.ini ./
COPY alembic ./alembic
COPY app ./app

RUN useradd --system --uid 10001 appuser
USER appuser

EXPOSE 8000

# Aplica as migrations e sobe a API (exec faz o Uvicorn receber os sinais de parada do Docker).
CMD ["sh", "-c", "alembic upgrade head && exec uvicorn app.main:app --host 0.0.0.0 --port 8000"]
