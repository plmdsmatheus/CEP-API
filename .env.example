# Banco de dados (docker-compose)
POSTGRES_USER=cep
POSTGRES_PASSWORD=cep
POSTGRES_DB=cep
# Porta do Postgres no host (útil para rodar a API e os testes fora do Docker)
POSTGRES_PORT=5434

# Aplicação web (frontend + proxy da API): http://localhost:${WEB_PORT}
WEB_PORT=8080

# ViaCEP (opcional; estes são os valores padrão)
VIACEP_BASE_URL=https://viacep.com.br/ws
VIACEP_TIMEOUT_SECONDS=5
